# ---------------------------------------------------------------------------
# REG.RU Control — application configuration
#
# Copy this file to `.env` and fill in the values.
# `.env` is never committed and never leaves the server.
# Generate APP_KEY with:  php backend/bin/regru key:generate
# ---------------------------------------------------------------------------

# Application
APP_NAME="REG.RU Control"
APP_ENV=production          # production | development | test
APP_DEBUG=0                 # 1 = verbose errors (never in production)
APP_URL=https://example.com/regru/
APP_TIMEZONE=Europe/Moscow
APP_KEY=                    # base64:32 bytes, REQUIRED
APP_TRUSTED_PROXIES=        # comma-separated proxy IPs, empty = trust none

# Storage (relative paths are resolved from the application root)
DB_PATH=var/regru.sqlite
LOG_PATH=var/log/app.log
LOG_LEVEL=info              # debug | info | warning | error
SESSION_NAME=rg_session
SESSION_IDLE=1800           # seconds of inactivity before logout
SESSION_SECURE=1            # 1 = cookie only over HTTPS (production)

# REG.RU API v2
REGRU_BASE_URL="https://api.reg.ru/api/regru2/"
REGRU_TIMEOUT=20            # seconds per HTTP request
REGRU_RETRIES=3             # retries for network/5xx errors only
REGRU_RATE_LIMIT_PER_HOUR=1100

# Inventory synchronisation
SYNC_TTL=3600               # seconds between automatic background syncs
