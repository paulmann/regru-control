# ---------------------------------------------------------------------------
# Deployment settings for tools/deploy.ps1 — copy to `.env.deploy` (gitignored).
# Never commit real hostnames, addresses or paths: this file is personal.
# ---------------------------------------------------------------------------

REGRU_HOST=server.example.com
REGRU_SSH_USER=root
REGRU_SSH_KEY=C:\Users\you\.ssh\id_ed25519

# Directory on the server that is the web root of the panel.
REGRU_REMOTE_PATH=/var/www/example/data/www/example.com/regru

# Owner of the site files (FastPanel/ISPmanager site user).
REGRU_SITE_USER=site_user

# Public URL of the panel (used in .env on the first deploy).
REGRU_APP_URL=https://example.com/regru/

# PHP-FPM binary and socket used by the site.
REGRU_PHP_BIN=/usr/bin/php
REGRU_FPM_SOCKET=/var/run/example.com.sock

# nginx access policy for the panel (comma-separated `allow` sources).
REGRU_ALLOW_CIDR=192.0.2.0/24
REGRU_ALLOW_IP=203.0.113.10
